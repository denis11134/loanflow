<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Assessment" targetNamespace="https://loanflow.example/assessment" exporter="LoanFlow" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="loanflow-assessment" name="Оценка кредитной заявки" isExecutable="true">
    <bpmn:documentation>Camunda управляет этапами и ожиданиями оценки. Данные оценки и результаты находятся в PostgreSQL; переменные процесса: assessmentId, route, waitDuration.</bpmn:documentation>
    <bpmn:startEvent id="Start" name="Начало оценки">
      <bpmn:outgoing>Flow_Start_REGISTER</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_REGISTER" name="Зарегистрировать экземпляр">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loanflow-assessment-register" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_REGISTER</bpmn:incoming>
      <bpmn:outgoing>Flow_REGISTER_Route</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_REGISTER" name="Экземпляр принят?">
      <bpmn:incoming>Flow_REGISTER_Route</bpmn:incoming>
      <bpmn:outgoing>Flow_REGISTER_STOP</bpmn:outgoing>
      <bpmn:outgoing>Flow_REGISTER_NEXT</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_REGISTER" name="Дубликат процесса">
      <bpmn:incoming>Flow_REGISTER_STOP</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_REGISTER" sourceRef="Start" targetRef="Task_REGISTER" />
    <bpmn:sequenceFlow id="Flow_REGISTER_Route" sourceRef="Task_REGISTER" targetRef="Gateway_REGISTER" />
    <bpmn:sequenceFlow id="Flow_REGISTER_STOP" sourceRef="Gateway_REGISTER" targetRef="End_REGISTER" name="Остановить">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "STOP"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_AML" name="Проверить AML">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loanflow-assessment-AML" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_REGISTER_NEXT</bpmn:incoming>
      <bpmn:incoming>Flow_AML_Resume</bpmn:incoming>
      <bpmn:outgoing>Flow_AML_Route</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AML" name="Исход этапа">
      <bpmn:incoming>Flow_AML_Route</bpmn:incoming>
      <bpmn:outgoing>Flow_AML_NEXT</bpmn:outgoing>
      <bpmn:outgoing>Flow_AML_FINISH</bpmn:outgoing>
      <bpmn:outgoing>Flow_AML_STOP</bpmn:outgoing>
      <bpmn:outgoing>Flow_AML_WAIT</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_STOP_AML" name="Оценка остановлена">
      <bpmn:incoming>Flow_AML_STOP</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Timer_AML" name="Пауза / повтор">
      <bpmn:incoming>Flow_AML_WAIT</bpmn:incoming>
      <bpmn:outgoing>Flow_AML_Resume</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDefinition_AML">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= waitDuration</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_PASSPORT" name="Проверить паспорт и согласие">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loanflow-assessment-PASSPORT" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AML_NEXT</bpmn:incoming>
      <bpmn:incoming>Flow_PASSPORT_Resume</bpmn:incoming>
      <bpmn:outgoing>Flow_PASSPORT_Route</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PASSPORT" name="Исход этапа">
      <bpmn:incoming>Flow_PASSPORT_Route</bpmn:incoming>
      <bpmn:outgoing>Flow_PASSPORT_NEXT</bpmn:outgoing>
      <bpmn:outgoing>Flow_PASSPORT_FINISH</bpmn:outgoing>
      <bpmn:outgoing>Flow_PASSPORT_STOP</bpmn:outgoing>
      <bpmn:outgoing>Flow_PASSPORT_WAIT</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_STOP_PASSPORT" name="Оценка остановлена">
      <bpmn:incoming>Flow_PASSPORT_STOP</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Timer_PASSPORT" name="Пауза / повтор">
      <bpmn:incoming>Flow_PASSPORT_WAIT</bpmn:incoming>
      <bpmn:outgoing>Flow_PASSPORT_Resume</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDefinition_PASSPORT">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= waitDuration</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_CREDIT_REPORT" name="Получить КБКИ и проверить данные">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loanflow-assessment-CREDIT_REPORT" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PASSPORT_NEXT</bpmn:incoming>
      <bpmn:incoming>Flow_CREDIT_REPORT_Resume</bpmn:incoming>
      <bpmn:outgoing>Flow_CREDIT_REPORT_Route</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CREDIT_REPORT" name="Исход этапа">
      <bpmn:incoming>Flow_CREDIT_REPORT_Route</bpmn:incoming>
      <bpmn:outgoing>Flow_CREDIT_REPORT_NEXT</bpmn:outgoing>
      <bpmn:outgoing>Flow_CREDIT_REPORT_FINISH</bpmn:outgoing>
      <bpmn:outgoing>Flow_CREDIT_REPORT_STOP</bpmn:outgoing>
      <bpmn:outgoing>Flow_CREDIT_REPORT_WAIT</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_STOP_CREDIT_REPORT" name="Оценка остановлена">
      <bpmn:incoming>Flow_CREDIT_REPORT_STOP</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Timer_CREDIT_REPORT" name="Пауза / повтор">
      <bpmn:incoming>Flow_CREDIT_REPORT_WAIT</bpmn:incoming>
      <bpmn:outgoing>Flow_CREDIT_REPORT_Resume</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDefinition_CREDIT_REPORT">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= waitDuration</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_FRAUD" name="Проверить антифрод и рассчитать условия">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loanflow-assessment-FRAUD" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CREDIT_REPORT_NEXT</bpmn:incoming>
      <bpmn:incoming>Flow_FRAUD_Resume</bpmn:incoming>
      <bpmn:outgoing>Flow_FRAUD_Route</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_FRAUD" name="Исход этапа">
      <bpmn:incoming>Flow_FRAUD_Route</bpmn:incoming>
      <bpmn:outgoing>Flow_FRAUD_NEXT</bpmn:outgoing>
      <bpmn:outgoing>Flow_FRAUD_FINISH</bpmn:outgoing>
      <bpmn:outgoing>Flow_FRAUD_STOP</bpmn:outgoing>
      <bpmn:outgoing>Flow_FRAUD_WAIT</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_STOP_FRAUD" name="Оценка остановлена">
      <bpmn:incoming>Flow_FRAUD_STOP</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Timer_FRAUD" name="Пауза / повтор">
      <bpmn:incoming>Flow_FRAUD_WAIT</bpmn:incoming>
      <bpmn:outgoing>Flow_FRAUD_Resume</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDefinition_FRAUD">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= waitDuration</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_DE" name="Подготовить рекомендацию DE">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loanflow-assessment-DE" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FRAUD_NEXT</bpmn:incoming>
      <bpmn:incoming>Flow_DE_Resume</bpmn:incoming>
      <bpmn:outgoing>Flow_DE_Route</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DE" name="Исход этапа">
      <bpmn:incoming>Flow_DE_Route</bpmn:incoming>
      <bpmn:outgoing>Flow_DE_NEXT</bpmn:outgoing>
      <bpmn:outgoing>Flow_DE_FINISH</bpmn:outgoing>
      <bpmn:outgoing>Flow_DE_STOP</bpmn:outgoing>
      <bpmn:outgoing>Flow_DE_WAIT</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_STOP_DE" name="Оценка остановлена">
      <bpmn:incoming>Flow_DE_STOP</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Timer_DE" name="Пауза / повтор">
      <bpmn:incoming>Flow_DE_WAIT</bpmn:incoming>
      <bpmn:outgoing>Flow_DE_Resume</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDefinition_DE">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= waitDuration</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_FINALIZE" name="Зафиксировать результат и outbox">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loanflow-assessment-finalize" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AML_FINISH</bpmn:incoming>
      <bpmn:incoming>Flow_PASSPORT_FINISH</bpmn:incoming>
      <bpmn:incoming>Flow_CREDIT_REPORT_FINISH</bpmn:incoming>
      <bpmn:incoming>Flow_FRAUD_FINISH</bpmn:incoming>
      <bpmn:incoming>Flow_DE_NEXT</bpmn:incoming>
      <bpmn:incoming>Flow_DE_FINISH</bpmn:incoming>
      <bpmn:incoming>Flow_FINALIZE_Resume</bpmn:incoming>
      <bpmn:outgoing>Flow_FINALIZE_Route</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_FINALIZE" name="Результат фиксации">
      <bpmn:incoming>Flow_FINALIZE_Route</bpmn:incoming>
      <bpmn:outgoing>Flow_FINALIZE_WAIT</bpmn:outgoing>
      <bpmn:outgoing>Flow_FINALIZE_END</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Timer_FINALIZE" name="Ожидать ядро">
      <bpmn:incoming>Flow_FINALIZE_WAIT</bpmn:incoming>
      <bpmn:outgoing>Flow_FINALIZE_Resume</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDefinition_FINALIZE">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= waitDuration</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End" name="Оценка завершена">
      <bpmn:incoming>Flow_FINALIZE_END</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_REGISTER_NEXT" sourceRef="Gateway_REGISTER" targetRef="Task_AML" name="Продолжить">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "NEXT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AML_Route" sourceRef="Task_AML" targetRef="Gateway_AML" />
    <bpmn:sequenceFlow id="Flow_AML_NEXT" sourceRef="Gateway_AML" targetRef="Task_PASSPORT" name="Следующий этап">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "NEXT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AML_FINISH" sourceRef="Gateway_AML" targetRef="Task_FINALIZE" name="Результат готов">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "FINISH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AML_STOP" sourceRef="Gateway_AML" targetRef="End_STOP_AML" name="Остановить">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "STOP"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AML_WAIT" sourceRef="Gateway_AML" targetRef="Timer_AML" name="Ожидать">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "WAIT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AML_Resume" sourceRef="Timer_AML" targetRef="Task_AML" />
    <bpmn:sequenceFlow id="Flow_PASSPORT_Route" sourceRef="Task_PASSPORT" targetRef="Gateway_PASSPORT" />
    <bpmn:sequenceFlow id="Flow_PASSPORT_NEXT" sourceRef="Gateway_PASSPORT" targetRef="Task_CREDIT_REPORT" name="Следующий этап">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "NEXT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PASSPORT_FINISH" sourceRef="Gateway_PASSPORT" targetRef="Task_FINALIZE" name="Результат готов">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "FINISH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PASSPORT_STOP" sourceRef="Gateway_PASSPORT" targetRef="End_STOP_PASSPORT" name="Остановить">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "STOP"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PASSPORT_WAIT" sourceRef="Gateway_PASSPORT" targetRef="Timer_PASSPORT" name="Ожидать">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "WAIT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PASSPORT_Resume" sourceRef="Timer_PASSPORT" targetRef="Task_PASSPORT" />
    <bpmn:sequenceFlow id="Flow_CREDIT_REPORT_Route" sourceRef="Task_CREDIT_REPORT" targetRef="Gateway_CREDIT_REPORT" />
    <bpmn:sequenceFlow id="Flow_CREDIT_REPORT_NEXT" sourceRef="Gateway_CREDIT_REPORT" targetRef="Task_FRAUD" name="Следующий этап">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "NEXT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CREDIT_REPORT_FINISH" sourceRef="Gateway_CREDIT_REPORT" targetRef="Task_FINALIZE" name="Результат готов">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "FINISH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CREDIT_REPORT_STOP" sourceRef="Gateway_CREDIT_REPORT" targetRef="End_STOP_CREDIT_REPORT" name="Остановить">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "STOP"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CREDIT_REPORT_WAIT" sourceRef="Gateway_CREDIT_REPORT" targetRef="Timer_CREDIT_REPORT" name="Ожидать">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "WAIT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CREDIT_REPORT_Resume" sourceRef="Timer_CREDIT_REPORT" targetRef="Task_CREDIT_REPORT" />
    <bpmn:sequenceFlow id="Flow_FRAUD_Route" sourceRef="Task_FRAUD" targetRef="Gateway_FRAUD" />
    <bpmn:sequenceFlow id="Flow_FRAUD_NEXT" sourceRef="Gateway_FRAUD" targetRef="Task_DE" name="Следующий этап">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "NEXT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FRAUD_FINISH" sourceRef="Gateway_FRAUD" targetRef="Task_FINALIZE" name="Результат готов">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "FINISH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FRAUD_STOP" sourceRef="Gateway_FRAUD" targetRef="End_STOP_FRAUD" name="Остановить">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "STOP"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FRAUD_WAIT" sourceRef="Gateway_FRAUD" targetRef="Timer_FRAUD" name="Ожидать">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "WAIT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FRAUD_Resume" sourceRef="Timer_FRAUD" targetRef="Task_FRAUD" />
    <bpmn:sequenceFlow id="Flow_DE_Route" sourceRef="Task_DE" targetRef="Gateway_DE" />
    <bpmn:sequenceFlow id="Flow_DE_NEXT" sourceRef="Gateway_DE" targetRef="Task_FINALIZE" name="Следующий этап">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "NEXT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DE_FINISH" sourceRef="Gateway_DE" targetRef="Task_FINALIZE" name="Результат готов">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "FINISH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DE_STOP" sourceRef="Gateway_DE" targetRef="End_STOP_DE" name="Остановить">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "STOP"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DE_WAIT" sourceRef="Gateway_DE" targetRef="Timer_DE" name="Ожидать">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "WAIT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DE_Resume" sourceRef="Timer_DE" targetRef="Task_DE" />
    <bpmn:sequenceFlow id="Flow_FINALIZE_Route" sourceRef="Task_FINALIZE" targetRef="Gateway_FINALIZE" />
    <bpmn:sequenceFlow id="Flow_FINALIZE_WAIT" sourceRef="Gateway_FINALIZE" targetRef="Timer_FINALIZE" name="Ожидать">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "WAIT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FINALIZE_Resume" sourceRef="Timer_FINALIZE" targetRef="Task_FINALIZE" />
    <bpmn:sequenceFlow id="Flow_FINALIZE_END" sourceRef="Gateway_FINALIZE" targetRef="End" name="Завершить / остановить">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= route = "FINISH" or route = "STOP"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Assessment">
    <bpmndi:BPMNPlane id="Plane_Assessment" bpmnElement="loanflow-assessment">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="492" y="20" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="447" y="61" width="126" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_REGISTER_di" bpmnElement="Task_REGISTER">
        <dc:Bounds x="430" y="95" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_REGISTER_di" bpmnElement="Gateway_REGISTER" isMarkerVisible="true">
        <dc:Bounds x="485" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="345" y="200" width="125" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_REGISTER_di" bpmnElement="End_REGISTER">
        <dc:Bounds x="690" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="645" y="263" width="126" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AML_di" bpmnElement="Task_AML">
        <dc:Bounds x="430" y="325" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AML_di" bpmnElement="Gateway_AML" isMarkerVisible="true">
        <dc:Bounds x="485" y="440" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="345" y="425" width="125" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_STOP_AML_di" bpmnElement="End_STOP_AML">
        <dc:Bounds x="690" y="425" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="645" y="388" width="126" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_AML_di" bpmnElement="Timer_AML">
        <dc:Bounds x="782" y="502" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="737" y="543" width="126" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PASSPORT_di" bpmnElement="Task_PASSPORT">
